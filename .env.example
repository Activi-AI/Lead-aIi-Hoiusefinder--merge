# Lead-AI Housefinder Environment Variables

# MCP Server Configuration
LB_BACKEND_BASE=http://localhost:3003
LB_SSH_HOST=localhost
LB_SSH_USER=user
LB_SSH_PASSWORD=password

# API Keys
OPENAI_API_KEY=your_openai_key
ANTHROPIC_API_KEY=your_anthropic_key
SIPGATE_API_KEY=your_sipgate_key
VONAGE_API_KEY=your_vonage_key

# Database
DATABASE_URL=sqlite:///./database.db

# Scraping
SCRAPER_TIMEOUT=30
SCRAPER_USER_AGENT=Mozilla/5.0

# Logging
LOG_LEVEL=INFO